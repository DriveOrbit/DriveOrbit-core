# Docker ignore file for DriveOrbit
# Ignore files that shouldn't be included in Docker context

# Target directory (Maven build output) - excluding only non-JAR files
target/classes/
target/test-classes/
target/maven-archiver/
target/maven-status/
target/surefire-reports/
target/generated-sources/
target/generated-test-sources/
# Keep JAR files in target/ for Docker build

# IDE files
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.project
.classpath

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Git
.git/
.gitignore

# Maven
.mvn/
mvnw
mvnw.cmd

# Logs
logs/
*.log

# Environment files
.env
.env.local
.env.production

# Temporary files
*.tmp
*.temp

# Node modules (if any frontend)
node_modules/

# Docker files (don't copy into image)
Dockerfile
docker-compose.yml
.dockerignore

# Documentation
README.md
*.md

# Test files
src/test/

# Backup files
*.bak
*.backup
